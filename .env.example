# SentinelSleep environment template.
# Copy to .env (gitignored) and fill in values as needed.

# Hugging Face token — only required for gated/private models.
# AST, wav2vec2, MusicGen, and AudioLDM2 are all public (no token needed).
HF_TOKEN=

# Optional: override Hugging Face cache directory.
# HF_HOME=

# Optional: pin sounddevice input/output device indices.
# Run `python -c "import sounddevice; print(sounddevice.query_devices())"` to list devices.
# SENTINELSLEEP_INPUT_DEVICE=
# SENTINELSLEEP_OUTPUT_DEVICE=
